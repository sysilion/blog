#!/usr/bin/env node
// 비밀글 가드. 비밀번호는 필요 없다 — 해시만 대조한다.
//
// 잡는 것:
//   1. content/secret/ 에 암호문이 아닌 파일이 스테이징됐다 (평문을 잘못 뒀다)
//   2. 스텁을 커밋하는데 data/secret.json 이 없다 (아무도 못 연다)
//   3. 발행된 비밀글의 원문을 고쳐놓고 재암호화를 안 했다 ← 조용히 사고나는 지점
//   4. 아직 암호화 안 된 새 원문이 있다 (경고만)
//
// 설치: git config core.hooksPath githooks
// 우회: git commit --no-verify

import { execFileSync } from 'node:child_process';
import { createHash } from 'node:crypto';
import fs from 'node:fs';
import path from 'node:path';

const git = (...args) => execFileSync('git', args, { encoding: 'utf8' }).trim();
const ROOT = git('rev-parse', '--show-toplevel');
const at = (...p) => path.join(ROOT, ...p);

const SRC_DIR = at('secret-src');
const OUT_DIR = at('content', 'secret');
const KEYCHAIN = at('data', 'secret.json');
const CACHE = at('.secret-cache.json');

const errors = [];
const warnings = [];

const staged = git('diff', '--cached', '--name-only', '--diff-filter=ACM')
  .split('\n')
  .filter(Boolean);
const stagedStubs = staged.filter(
  (p) => p.startsWith('content/secret/') && p.endsWith('.md') && !p.endsWith('_index.md')
);

// 1. 스테이징된 내용 자체를 본다. 작업트리가 아니라 인덱스가 커밋되는 것이므로.
for (const p of stagedStubs) {
  let body = '';
  try {
    body = execFileSync('git', ['show', `:${p}`], { encoding: 'utf8' });
  } catch {
    continue;
  }
  if (!/^secret_ct:/m.test(body)) {
    errors.push(`평문으로 보인다: ${p}\n    비밀글 본문은 secret-src/ 에 두고 암호화해야 한다.`);
  }
}

// 2. 스텁만 있고 키체인이 없으면 아무도 못 연다.
if (stagedStubs.length && !fs.existsSync(KEYCHAIN) && !staged.includes('data/secret.json')) {
  errors.push('data/secret.json 이 없다. 키체인 없이는 어떤 비밀글도 열리지 않는다.');
}

// 3·4. 원문과 스텁이 어긋났는지. secret-src 가 없으면(복원 전 클론) 건너뛴다.
const sources = fs.existsSync(SRC_DIR)
  ? fs.readdirSync(SRC_DIR).filter((f) => f.endsWith('.md')).sort()
  : [];

if (sources.length) {
  const cache = fs.existsSync(CACHE) ? JSON.parse(fs.readFileSync(CACHE, 'utf8')) : null;
  const stale = [];
  const unencrypted = [];

  for (const file of sources) {
    const slug = path.basename(file, '.md');
    const digest = createHash('sha256')
      .update(fs.readFileSync(path.join(SRC_DIR, file)))
      .digest('hex');
    const hasStub = fs.existsSync(path.join(OUT_DIR, `${slug}.md`));

    if (!hasStub) unencrypted.push(slug);
    else if (!cache || cache[slug]?.digest !== digest) stale.push(slug);
  }

  // 이미 발행된 글을 고쳐놓고 안 구웠다 → 그대로 커밋하면 사이트는 옛 내용을 계속 보여준다.
  if (stale.length) {
    errors.push(
      `원문이 바뀌었는데 재암호화하지 않았다: ${stale.join(', ')}\n` +
        '    그대로 커밋하면 사이트에는 예전 내용이 남는다. → node scripts/secret.mjs'
    );
  }
  // 아직 발행 안 한 새 원문은 그냥 초안일 수 있다. 막지는 않는다.
  if (unencrypted.length) {
    warnings.push(
      `암호화되지 않은 원문: ${unencrypted.join(', ')} — 발행하려면 node scripts/secret.mjs`
    );
  }

  // 원문이 사라진 스텁. 지우는 건 사람이 판단할 일이라 알려만 준다.
  if (fs.existsSync(OUT_DIR)) {
    const orphans = fs
      .readdirSync(OUT_DIR)
      .filter((f) => f.endsWith('.md') && f !== '_index.md')
      .map((f) => path.basename(f, '.md'))
      .filter((slug) => !sources.includes(`${slug}.md`));
    if (orphans.length) warnings.push(`평문 없는 스텁: ${orphans.join(', ')}`);
  }
}

for (const w of warnings) console.error(`  경고: ${w}`);

if (errors.length) {
  console.error('\n비밀글 가드가 커밋을 멈췄다.\n');
  for (const e of errors) console.error(`  · ${e}`);
  console.error('\n의도한 커밋이라면 git commit --no-verify\n');
  process.exit(1);
}
