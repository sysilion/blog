{{/* PaperMod 원본은 .Scratch 를 쓴다. hugo server 증분 리빌드마다 Scratch 가 누적돼
     로컬 검색 인덱스에 같은 글이 계속 중복된다. slice append 로 대체.
     본문의 [[용어]] 위키링크는 표시명만 남기고 대괄호를 벗겨 색인한다. */}}
{{- $index := slice -}}
{{- range site.RegularPages -}}
    {{- if and (not .Params.searchHidden) (ne .Layout `archives`) (ne .Layout `search`) -}}
        {{- $plain := .Plain -}}
        {{- $plain = replaceRE `\[\[[^\]|]+\|([^\]]+)\]\]` "$1" $plain -}}
        {{- $plain = replaceRE `\[\[([^\]]+)\]\]` "$1" $plain -}}
        {{- $index = $index | append (dict "title" .Title "content" $plain "permalink" .Permalink "summary" .Summary) -}}
    {{- end -}}
{{- end -}}
{{- $index | jsonify -}}
